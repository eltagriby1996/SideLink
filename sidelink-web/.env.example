# SideLink Link Unlock — Backend Environment Variables
# Provide real values in your Vercel Project Settings

# Base URL for verification gateway (e.g. https://www.sidelinktool.me)
VERIFICATION_BASE_URL="https://www.sidelinktool.me"

# Database Connection String for persistent session store (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Cryptographic Token Signing Configuration
TOKEN_ISSUER="sidelink-verification"
TOKEN_AUDIENCE="sidelink-client"
TOKEN_SIGNING_KEY_ID="sidelink-key-v1"
TOKEN_SIGNING_PRIVATE_KEY="YOUR_SECURE_RANDOM_SECRET_KEY_MINIMUM_32_BYTES"

# Optional: Rate limiting and abuse prevention (requests per minute)
RATE_LIMIT_MAX_PER_MINUTE="60"
