<Window x:Class="SideLink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SideLink.App"
        xmlns:vm="clr-namespace:SideLink.App.ViewModels"
        mc:Ignorable="d"
        Title="SideLink — Modern iOS IPA Sideloading &amp; 7-Day Refresh Manager" 
        Height="760" Width="1140"
        MinHeight="640" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BgDarkBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="8" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Nav Button Active State Styles based on CurrentPage -->
        <Style x:Key="NavBtnIpa" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="IpaLibrary">
                    <Setter Property="Background" Value="{StaticResource ActiveNavGradient}" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavBtnDashboard" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard">
                    <Setter Property="Background" Value="{StaticResource ActiveNavGradient}" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavBtnInstalled" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="InstalledApps">
                    <Setter Property="Background" Value="{StaticResource ActiveNavGradient}" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavBtnDevices" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Devices">
                    <Setter Property="Background" Value="{StaticResource ActiveNavGradient}" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavBtnSigning" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="SigningRefresh">
                    <Setter Property="Background" Value="{StaticResource ActiveNavGradient}" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="NavBtnDiagnostics" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Diagnostics">
                    <Setter Property="Background" Value="{StaticResource ActiveNavGradient}" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavBtnLogs" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Logs">
                    <Setter Property="Background" Value="{StaticResource ActiveNavGradient}" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavBtnSettings" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                    <Setter Property="Background" Value="{StaticResource ActiveNavGradient}" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border -->
    <Border Background="{StaticResource BgDarkBrush}" 
            BorderBrush="{StaticResource CardBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" /> <!-- Custom Modern Title Bar -->
                <RowDefinition Height="*" />  <!-- Main Work Area -->
            </Grid.RowDefinitions>

            <!-- Custom Modern Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Header with Official Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#1D2A45" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="SideLink" FontWeight="Black" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                    <Border Background="#1E3A8A" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0 STABLE" FontSize="9" FontWeight="Bold" Foreground="#93C5FD" />
                    </Border>
                </StackPanel>

                <!-- Connected Device Indicator Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="#101728" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="14,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#64748B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dashboard.IsDeviceConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Dashboard.DeviceStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="40" Height="30" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" Content="—" Click="MinimizeButton_Click" Cursor="Hand" FontSize="12" />
                    <Button Width="40" Height="30" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" Content="☐" Click="MaximizeButton_Click" Cursor="Hand" FontSize="12" />
                    <Button Width="40" Height="30" Background="Transparent" Foreground="#F87171" BorderThickness="0" Content="✕" Click="CloseButton_Click" Cursor="Hand" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- Main Layout (Sidebar + Content) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" /> <!-- Sidebar -->
                    <ColumnDefinition Width="*" />   <!-- Content Views -->
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="True">
                        <!-- Navigation Items -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
                            <StackPanel Margin="0,14,0,0">
                                <!-- Group 1: Core -->
                                <TextBlock Text="الرئيسية (MAIN)" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="18,0,0,6" />
                                <Button Style="{StaticResource NavBtnIpa}" Content="📦  تثبيت التطبيقات (IPA)" Command="{Binding NavigateCommand}" CommandParameter="IpaLibrary" />
                                <Button Style="{StaticResource NavBtnDashboard}" Content="📊  لوحة التحكم (Dashboard)" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                                <Button Style="{StaticResource NavBtnInstalled}" Content="📱  التطبيقات المثبتة" Command="{Binding NavigateCommand}" CommandParameter="InstalledApps" />

                                <!-- Group 2: Devices & Signing -->
                                <TextBlock Text="الأجهزة والشهادات" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="18,14,0,6" />
                                <Button Style="{StaticResource NavBtnDevices}" Content="📲  الأجهزة المتصلة" Command="{Binding NavigateCommand}" CommandParameter="Devices" />
                                <Button Style="{StaticResource NavBtnSigning}" Content="🔑  التوقيع والحسابات" Command="{Binding NavigateCommand}" CommandParameter="SigningRefresh" />

                                <!-- Group 3: System -->
                                <TextBlock Text="النظام والإعدادات" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="18,14,0,6" />
                                <Button Style="{StaticResource NavBtnDiagnostics}" Content="🩺  فحص النظام والتعريفات" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" />
                                <Button Style="{StaticResource NavBtnLogs}" Content="📜  السجلات (Logs)" Command="{Binding NavigateCommand}" CommandParameter="Logs" />
                                <Button Style="{StaticResource NavBtnSettings}" Content="⚙️  الإعدادات (Settings)" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Device / Info Card -->
                        <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" Background="#101726" CornerRadius="10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SideLink Pro Engine" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" />
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="4" Padding="4,1">
                                        <TextBlock Text="READY" FontSize="8" FontWeight="Bold" Foreground="#34D399" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="توقيع محلي مشفر 100%" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Column="1" Background="{StaticResource BgDarkBrush}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Banners Container (Broadcast Banner & Update Notification) -->
                    <StackPanel Grid.Row="0">
                        <!-- Dynamic Remote Broadcast Banner -->
                        <Border Margin="0,0,0,16" 
                                Background="{Binding BroadcastBannerBg}" 
                                BorderBrush="{Binding BroadcastBannerBorder}" 
                                BorderThickness="1.5" 
                                CornerRadius="12" 
                                Padding="16,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBroadcastBannerVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding BroadcastBannerIcon}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                                
                                <TextBlock Grid.Column="1" Text="{Binding BroadcastBannerMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
                                
                                <Button Grid.Column="2" Content="✕" Command="{Binding DismissBroadcastBannerCommand}" 
                                        Background="Transparent" BorderThickness="0" Foreground="#CBD5E1" 
                                        FontSize="11" Padding="6,2" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Non-forced Update Available Banner -->
                        <Border Margin="0,0,0,16" 
                                Background="#064E3B" 
                                BorderBrush="#10B981" 
                                BorderThickness="1.5" 
                                CornerRadius="12" 
                                Padding="16,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="🚀" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="يتوفر تحديث جديد لـ SideLink: " FontSize="12.5" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="{Binding AvailableUpdateVersion, StringFormat='v{0}'}" FontSize="12.5" FontWeight="Bold" Foreground="#34D399" FontFamily="Consolas" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AvailableUpdateNotes}" FontSize="11" Foreground="#A7F3D0" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                
                                <Button Grid.Column="2" Content="تحميل التحديث (Download)" 
                                        Command="{Binding OpenAvailableUpdateUrlCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Padding="12,6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Work Views Container -->
                    <Grid Grid.Row="1">

                    <!-- ======================================================== -->
                    <!-- PAGE 1: IPA LIBRARY (Primary App Experience) -->
                    <!-- ======================================================== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="IpaLibrary">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <!-- Header -->
                            <TextBlock Text="تثبيت وتوقيع تطبيقات iOS (IPA Package)" FontSize="24" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="اسحب أي تطبيق أو لعبة بصيغة .ipa لتوقيعها بشهادتك الشخصية وتثبيتها مباشرة على هاتفك" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16" />

                            <!-- SideLink Container Banner: Break 3-App Limit -->
                            <Border Background="#0F172A" 
                                    BorderBrush="#38BDF8" 
                                    BorderThickness="1.5" 
                                    CornerRadius="16" 
                                    Padding="20,16" 
                                    Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Container Badge Icon -->
                                    <Border Width="50" Height="50" CornerRadius="12" Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="SideLink Container (تجاوز حد الـ 3 تطبيقات)" FontSize="15" FontWeight="Bold" Foreground="White" />
                                            <Border Background="#065F46" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="حل حصري للأبد" FontSize="9" FontWeight="Bold" Foreground="#34D399" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="شغّل عدد لا نهائي من التطبيقات والألعاب المعدلة بنفس الشهادة المجانية دون استهلاك خانات أبل الإضافية (تستهلك خانة 1 فقط وبكامل سرعة الجهاز 100%)." 
                                                   FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="2" 
                                            Style="{StaticResource PrimaryButtonStyle}" 
                                            Content="🚀 تثبيت الحاوية بضغطة واحدة" 
                                            Command="{Binding IpaLibrary.InstallSideLinkContainerCommand}" 
                                            VerticalAlignment="Center" 
                                            Padding="16,10" 
                                            FontSize="12" 
                                            FontWeight="Bold" />
                                </Grid>
                            </Border>

                            <!-- Interactive Drag & Drop Zone -->
                            <Border Background="#101728" 
                                    BorderBrush="#2563EB" 
                                    BorderThickness="1.5" 
                                    CornerRadius="16" 
                                    Padding="28,24" 
                                    Margin="0,0,0,20" 
                                    AllowDrop="True" 
                                    Drop="IpaDropzone_Drop"
                                    MouseLeftButtonUp="IpaDropzone_MouseLeftButtonUp"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Glowing Upload Icon -->
                                    <Border Width="56" Height="56" CornerRadius="14" Background="#1D2A45" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="اسحب وأفلت ملف IPA هنا للبدء فوراً" FontSize="16" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="أو اضغط على زر الاختيار لتحديد ملف التطبيق من جهاز الكمبيوتر الخاص بك" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="📂 اختيار ملف IPA..." Command="{Binding IpaLibrary.BrowseForIpaCommand}" VerticalAlignment="Center" Padding="18,10" />
                                </Grid>
                            </Border>

                            <!-- Inspected Application Card -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="تفاصيل ومعلومات التطبيق (Application Info)" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#1E2C48" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{Binding IpaLibrary.SelectedIpa.FormattedFileSize, TargetNullValue='No File'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        </Border>
                                    </Grid>

                                    <!-- App Hero Row -->
                                    <Border Background="#0D1322" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- App Squircle Frame -->
                                            <Border Width="60" Height="60" CornerRadius="14" Background="#1E3A8A" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="📱" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IpaLibrary.SelectedIpa.EffectiveTitle, TargetNullValue='يرجى اختيار أو إفلات ملف IPA أعلاه'}" FontSize="18" FontWeight="Black" Foreground="White" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Bundle ID: " FontSize="12" Foreground="{StaticResource TextSubtleBrush}" />
                                                    <TextBlock Text="{Binding IpaLibrary.SelectedIpa.BundleIdentifier, TargetNullValue='—'}" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" FontFamily="Consolas" />
                                                    <TextBlock Text="  •  الإصدار: " FontSize="12" Foreground="{StaticResource TextSubtleBrush}" Margin="10,0,0,0" />
                                                    <TextBlock Text="{Binding IpaLibrary.SelectedIpa.Version, TargetNullValue='—'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Distinct Bundle ID Option (Duplicate App Mode / App Cloner) -->
                                    <Border Background="#101A2D" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IpaLibrary.AutoModifyBundleId}" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" Cursor="Hand">
                                                <TextBlock Text="🛡️ تثبيت التطبيق كنسخة مكررة بمعرّف مختلف (استنساخ التطبيق - Dual App Cloner)" Foreground="White" FontWeight="Bold" />
                                            </CheckBox>
                                            <TextBlock Text="ميزة حصرية: تتيح استنساخ وتشغيل نسختين أو أكثر من أي تطبيق أو لعبة (مثل واتساب أو ألعاب) جنباً إلى جنب مع بيانات وحسابات معزولة بالكامل دون أي تعارض مع متجر App Store." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="24,0,0,10" TextWrapping="Wrap" LineHeight="16" />

                                            <!-- Quick 1-Click Clone Presets -->
                                            <StackPanel Orientation="Horizontal" Margin="24,0,0,12">
                                                <TextBlock Text="⚡ إجراءات استنساخ سريعة: " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="👯 استنساخ: نسخة 2" Command="{Binding IpaLibrary.CloneAsSecondInstanceCommand}" Padding="10,4" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" BorderBrush="#0284C7" ToolTip="تغيير اسم ومعرّف التطبيق لإنشاء نسخة ثانية معزولة" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="👯 استنساخ: نسخة 3" Command="{Binding IpaLibrary.CloneAsThirdInstanceCommand}" Padding="10,4" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" BorderBrush="#0284C7" ToolTip="تغيير اسم ومعرّف التطبيق لإنشاء نسخة ثالثة معزولة" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="🔄 إعادة ضبط للأصل" Command="{Binding IpaLibrary.ResetToOriginalCommand}" Padding="10,4" FontSize="11" Foreground="#94A3B8" ToolTip="إلغاء التعديلات والعودة للاسم والمعرّف الأصلي للحزمة" />
                                            </StackPanel>

                                            <Grid Margin="24,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم التطبيق (App Name):" FontSize="12" Foreground="#93C5FD" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding IpaLibrary.CustomDisplayName, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="10,6" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="معرّف التثبيت (Target ID):" FontSize="12" Foreground="#93C5FD" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IpaLibrary.TargetBundleId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="10,6" IsEnabled="{Binding IpaLibrary.AutoModifyBundleId}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Live Installation Progress & Status -->
                                    <StackPanel Margin="0,0,0,14">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IpaLibrary.IsInstalling}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IpaLibrary.StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" />
                                            <TextBlock Grid.Column="1" Text="{Binding IpaLibrary.InstallProgress, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                        </Grid>
                                        <ProgressBar Value="{Binding IpaLibrary.InstallProgress}" Maximum="100" Height="8" />
                                    </StackPanel>

                                    <!-- Operation Status / Error Alert -->
                                    <Border BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IpaLibrary.HasError}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Background" Value="#450A0A" />
                                                        <Setter Property="BorderBrush" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding IpaLibrary.ErrorMessage}" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Active Signing Account Indicator -->
                                    <Border Background="#101726" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔑  طريقة التوقيع المعتمدة: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding SigningRefresh.SavedAccountDisplay, TargetNullValue='حساب Apple ID'}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="⚙️ تغيير الشهادة / الحساب" Command="{Binding NavigateCommand}" CommandParameter="SigningRefresh" Padding="10,4" FontSize="11" />
                                        </Grid>
                                    </Border>

                                    <!-- Install CTA Button -->
                                    <Button Style="{StaticResource PrimaryButtonStyle}" 
                                            Content="🚀  توقيع وتثبيت التطبيق على الآيفون (Sign &amp; Install)" 
                                            Command="{Binding IpaLibrary.InstallSelectedIpaCommand}" 
                                            Padding="24,12" 
                                            FontSize="14" 
                                            FontWeight="Bold" 
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================================================== -->
                    <!-- PAGE 2: DASHBOARD -->
                    <!-- ======================================================== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <!-- Welcome Banner -->
                            <TextBlock Text="لوحة التحكم الرئيسية (Dashboard)" FontSize="24" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="نظرة عامة على حالة جهازك والتطبيقات المثبتة ودورات التجديد لشهادات الـ 7 أيام" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,20" />

                            <!-- Quick Stat Cards Grid -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Total Managed Apps -->
                                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="التطبيقات المثبتة" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Dashboard.TotalAppsCount}" FontSize="32" FontWeight="Black" Foreground="White" Margin="0,6,0,0" />
                                        <TextBlock Text="مثبتة عبر SideLink" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Expiring Soon -->
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="تنتهي قريباً (خلال 3 أيام)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" />
                                        <TextBlock Text="{Binding Dashboard.ExpiringSoonCount}" FontSize="32" FontWeight="Black" Foreground="{StaticResource WarningAmberBrush}" Margin="0,6,0,0" />
                                        <TextBlock Text="تحتاج للتجديد التلقائي" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Expired -->
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="منتهية الصلاحية" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" />
                                        <TextBlock Text="{Binding Dashboard.ExpiredCount}" FontSize="32" FontWeight="Black" Foreground="{StaticResource DangerRedBrush}" Margin="0,6,0,0" />
                                        <TextBlock Text="تتطلب إعادة التوقيع" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Quick Actions Row -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="العمليات السريعة" FontSize="15" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="{Binding Dashboard.OperationStatusText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="📦 تثبيت تطبيق (IPA)..." Command="{Binding Dashboard.NavigateToCommand}" CommandParameter="IpaLibrary" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="🔄 تجديد كافة التطبيقات" Command="{Binding Dashboard.RefreshAllAppsCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Recent Activities -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="سجل العمليات والنشاط الأخير" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" />
                                    <ListBox ItemsSource="{Binding Dashboard.RecentActivities}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" MaxHeight="220" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================================================== -->
                    <!-- PAGE 3: INSTALLED APPS -->
                    <!-- ======================================================== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="InstalledApps">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel Margin="0,0,14,20">
                            <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="التطبيقات المثبتة على الهاتف" FontSize="22" FontWeight="Black" Foreground="White" />
                                <TextBlock Text="{Binding InstalledApps.StatusMessage}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButtonStyle}" 
                                        Content="⚡ تجديد كل التطبيقات (تجديد فوري)" 
                                        Command="{Binding InstalledApps.RefreshAllAppsCommand}" 
                                        Margin="0,0,8,0" 
                                        Padding="14,8" 
                                        FontSize="13" 
                                        FontWeight="Bold"
                                        ToolTip="تجديد شهادات جميع التطبيقات المثبتة لـ 7 أيام إضافية دون إعادة التثبيت" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" 
                                        Content="🔄 تحديث القائمة" 
                                        Command="{Binding InstalledApps.LoadAppsCommand}" 
                                        Padding="12,8" 
                                        FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <!-- Installed Apps List -->
                        <ItemsControl ItemsSource="{Binding InstalledApps.Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon -->
                                            <Border Width="44" Height="44" Background="#1E3A8A" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="📱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppName}" FontSize="15" FontWeight="Bold" Foreground="White" />
                                                <TextBlock Text="{Binding BundleIdentifier}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" />
                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" Foreground="#64748B" />
                                            </StackPanel>

                                            <!-- Expiration Badge -->
                                            <Border Grid.Column="2" Background="#141E33" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ExpirationStatusBadge}" FontSize="11" FontWeight="Bold" Foreground="{Binding ExpirationBadgeColor}" />
                                            </Border>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="⚡ تجديد الشهادة" Command="{Binding DataContext.InstalledApps.RefreshSingleAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,8,0" Padding="14,6" FontSize="12" FontWeight="Bold" ToolTip="تجديد شهادة المطور لـ 7 أيام جديدة دون حذف بيانات أو محادثات التطبيق" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="✕ إزالة" Command="{Binding DataContext.InstalledApps.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,6" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                    <!-- ======================================================== -->
                    <!-- PAGE 4: DEVICES VIEW -->
                    <!-- ======================================================== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Devices">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="أجهزة iOS المتصلة (Connected Devices)" FontSize="22" FontWeight="Black" Foreground="White" />
                                <TextBlock Text="{Binding Devices.StatusMessage}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="🔄 إعادة فحص الأجهزة" Command="{Binding Devices.RefreshDevicesCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Devices.Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="50" Height="50" Background="#141E33" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="📱" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                                <TextBlock Text="{Binding ProductVersion, StringFormat='iOS Version: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding DeviceId, StringFormat='UDID: {0}'}" FontSize="11" Foreground="#64748B" FontFamily="Consolas" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                                <TextBlock Text="✓ متصل" FontWeight="Bold" FontSize="12" Foreground="#34D399" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- PAGE 5: SIGNING & REFRESH CONFIGURATION -->
                    <!-- ======================================================== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="SigningRefresh">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <TextBlock Text="إعدادات الحسابات والتوقيع (Apple ID &amp; Signing)" FontSize="22" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="إدارة حسابات Apple ID المخصصة للتوقيع الرقمي والتجديد التلقائي لشهادات الـ 7 أيام" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,16" />

                            <!-- Apple ID Credential Card -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Active Saved Account Banner -->
                                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SigningRefresh.HasStoredPassword}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="✓ الحساب محفوظ ومشفّر بنجاح في نظام ويندوز (Windows DPAPI)" FontWeight="Bold" FontSize="13" Foreground="#6EE7B7" />
                                                <TextBlock Text="{Binding SigningRefresh.SavedAccountDisplay}" FontSize="12" Foreground="#A7F3D0" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#047857" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="🔒 جاهز للتوقيع" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Status Message Alert -->
                                    <Border BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#064E3B" />
                                                <Setter Property="BorderBrush" Value="#059669" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SigningRefresh.IsSuccessStatus}" Value="False">
                                                        <Setter Property="Background" Value="#450A0A" />
                                                        <Setter Property="BorderBrush" Value="#7F1D1D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SigningRefresh.StatusMessage}" FontSize="12" Foreground="White" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Saved Accounts in SideLink -->
                                    <Border Background="#101726" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SigningRefresh.DiscoveredAccounts.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="⚡ حسابات Apple المحفوظة في SideLink:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding SigningRefresh.DiscoveredAccounts}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}" 
                                                                Command="{Binding DataContext.SigningRefresh.SelectDiscoveredAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"
                                                                Background="#172238" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" 
                                                                Padding="10,4" Margin="0,0,8,6" Cursor="Hand" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Apple ID (Email):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SigningRefresh.AppleId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                    <TextBlock Text="كلمة المرور أو كلمة السر الخاصة بالتطبيقات (Password):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="ApplePasswordInput" PasswordChanged="ApplePasswordInput_PasswordChanged" Background="{StaticResource InputBgBrush}" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,14" />

                                    <!-- Action Buttons -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                                Background="#2563EB" 
                                                Content="🔐 تسجيل الدخول والتحقق من حساب Apple (Sign-In &amp; 2FA)" 
                                                Command="{Binding SigningRefresh.Request2FaCommand}" 
                                                Margin="0,0,10,8" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                                Content="🗑️ مسح هذا الحساب من SideLink" 
                                                Command="{Binding SigningRefresh.ClearCredentialsCommand}" 
                                                Margin="0,0,10,8" />
                                    </WrapPanel>

                                    <!-- 2FA Code Input Box -->
                                    <Border Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,10,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SigningRefresh.Is2FaPromptVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="🔐 رمز المصادقة الثنائية من Apple (2FA Code)" FontWeight="Bold" FontSize="14" Foreground="#C7D2FE" />
                                            <TextBlock Text="أدخل الرمز المكون من 6 أرقام الظاهر على شاشة جهاز الآيفون:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,12" />

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SigningRefresh.TwoFactorCode, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontSize="16" FontWeight="Bold" MaxLength="6" 
                                                         Background="{StaticResource InputBgBrush}" Foreground="#38BDF8" BorderBrush="#818CF8" Padding="10,8" />
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="✓ تأكيد الرمز" Command="{Binding SigningRefresh.Verify2FaCodeCommand}" Margin="10,0,0,0" Padding="18,8" />
                                                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="✕ إلغاء" Command="{Binding SigningRefresh.Cancel2FaCommand}" Margin="8,0,0,0" Padding="14,8" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Custom P12 Certificate & Profile Card -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="🔏 استيراد شهادة مطور خارجية (Custom P12 &amp; Mobileprovision)" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" />
                                    <TextBlock Text="يتيح لك توقيع التطبيقات بشهادة P12 مخصصة وملف Mobileprovision خارجي لتفادي قيود الـ 7 أيام لحسابات Apple المجانية." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                                    <!-- P12 File Selection -->
                                    <TextBlock Text="ملف شهادة المطور والمفتاح الخاص (P12 Certificate):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SigningRefresh.P12Path, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="📂 اختيار P12..." Command="{Binding SigningRefresh.BrowseP12Command}" Margin="10,0,0,0" Padding="14,8" />
                                    </Grid>

                                    <!-- P12 Password -->
                                    <TextBlock Text="كلمة سر الشهادة (P12 Password) - اتركها فارغة إذا لم تكن محمية:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SigningRefresh.P12Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                    <!-- MobileProvision File Selection -->
                                    <TextBlock Text="ملف تعريف التثبيت (Mobileprovision Profile):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SigningRefresh.MobileProvisionPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="📂 اختيار Profile..." Command="{Binding SigningRefresh.BrowseMobileProvisionCommand}" Margin="10,0,0,0" Padding="14,8" />
                                    </Grid>

                                    <!-- Save Custom Cert Button -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                                Background="#059669" 
                                                Content="💾 حفظ واعتماد الشهادة المخصصة (Use Custom P12)" 
                                                Command="{Binding SigningRefresh.SaveCustomP12Command}" 
                                                Padding="20,10" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Certificate Details & Status Card -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📋 حالة وتفاصيل شهادة التوقيع النشطة" FontSize="16" FontWeight="Bold" Foreground="White" />
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="🔄 تحديث الحالة" Command="{Binding SigningRefresh.RefreshCertificateStatusCommand}" Padding="10,4" />
                                    </Grid>

                                    <Border Background="#101726" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="اسم الشهادة:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                                            <TextBlock Grid.Column="1" Text="{Binding SigningRefresh.CertificateSubject, TargetNullValue='غير متوفر'}" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Row="1" Text="معرّف الفريق (Team):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SigningRefresh.TeamId, TargetNullValue='—'}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8" />

                                            <TextBlock Grid.Row="2" Text="صلاحية التوقيع:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SigningRefresh.ExpirationDisplay, TargetNullValue='—'}" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" Margin="0,0,0,8" />

                                            <TextBlock Grid.Row="3" Text="حالة الجهاز المتصل:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SigningRefresh.ProvisioningStatusDisplay}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================================================== -->
                    <!-- PAGE 6: DIAGNOSTICS & SYSTEM -->
                    <!-- ======================================================== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Diagnostics">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="فحص وتشخيص النظام والتعريفات" FontSize="22" FontWeight="Black" Foreground="White" />
                                <TextBlock Text="التحقق من عمل خدمات Apple ومكتبات التوقيع وخادم usbmuxd" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="🔄 إعادة الفحص" Command="{Binding Diagnostics.RunDiagnosticsCommand}" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <ItemsControl ItemsSource="{Binding Diagnostics.DiagnosticItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="White" />
                                                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="Bold" FontSize="12" Foreground="#34D399" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- PAGE 7: LOGS -->
                    <!-- ======================================================== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Logs">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="سجلات البرنامج والتشخيص (Logs)" FontSize="22" FontWeight="Black" Foreground="White" />
                        <TextBlock Text="تتبع الأوامر وتفاصيل عمليات التوقيع وتثبيت ملفات الـ IPA" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,16" />

                        <Border Style="{StaticResource CardStyle}">
                            <TextBox Text="{Binding Logs.LogContent}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Height="420" Background="#0A0E1A" Foreground="#A7F3D0" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- PAGE 8: SETTINGS -->
                    <!-- ======================================================== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="إعدادات البرنامج (Application Settings)" FontSize="22" FontWeight="Black" Foreground="White" />
                        <TextBlock Text="تخصيص تفضيلات SideLink وبوابات الاتصال بالخادم" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,16" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Link Unlock Verification Gateway URL:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Settings.VerificationBackendUrl}" Margin="0,0,0,16" />

                                <TextBlock Text="Application Version:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                <TextBlock Text="SideLink v1.0.0 (Windows x64 Stable)" FontWeight="Bold" FontSize="13" Foreground="White" Margin="0,0,0,16" />

                                <TextBlock Text="سياسة الأمان والخصوصية:" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" />
                                <TextBlock Text="البرنامج لا يقوم بجمع أو إرسال أي كلمات سر أو بيانات Apple ID إلى أي خادم خارجي. كافة التوقيعات وعمليات التثبيت تتم محلياً 100% على جهازك." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- VIP License Management Card -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="إدارة ترخيص VIP والتحقق:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Settings.CurrentVipStatus}" FontSize="12" Foreground="#38BDF8" FontFamily="Consolas" Margin="0,0,0,12" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" 
                                        Content="إلغاء ربط كود VIP من هذا الجهاز وحذفه" 
                                        Command="{Binding Settings.UnlinkVipKeyCommand}" 
                                        HorizontalAlignment="Left" Padding="14,8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid> <!-- Close Work Views Container -->

                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- MANDATORY LINK UNLOCK LAUNCH GATE (Full Modal Overlay) -->
            <!-- ======================================================== -->
            <Grid Grid.Row="1" Background="#E6080C15" Panel.ZIndex="999">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAppUnlocked}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Center Modal Card -->
                <Border Width="500" 
                        Background="{StaticResource CardBgBrush}" 
                        BorderBrush="{StaticResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="18" 
                        Padding="36" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Official SideLink Logo -->
                        <Border Width="72" Height="72" CornerRadius="18" Background="#1D2A45" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Image Source="/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <TextBlock Text="تأكيد التحقق السريع من SideLink" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="يلزم إجراء خطوة تحقق سريعة عبر المتصفح لمرة واحدة عند بدء التشغيل لتأمين جلسة العمل." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" Margin="0,6,0,20" TextWrapping="Wrap" />

                        <!-- Session Info Box -->
                        <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="حالة الجلسة:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LinkUnlock.TimeRemainingText}" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas" />
                                </Grid>
                                <TextBlock Text="{Binding LinkUnlock.StatusText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LinkUnlock.SessionId, StringFormat='ID: {0}'}" FontSize="10" Foreground="#64748B" FontFamily="Consolas" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Error Box if any -->
                        <Border Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinkUnlock.HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding LinkUnlock.ErrorMessage}" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" />
                        </Border>

                        <!-- Success Animation Card (Visible when verification completes) -->
                        <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1.5" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinkUnlock.IsSuccessAnimation}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#047857" BorderBrush="#34D399" BorderThickness="2" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <TextBlock Text="✓" FontSize="28" FontWeight="Black" Foreground="#A7F3D0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="تم تأكيد الجلسة بنجاح!" FontSize="17" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="جاري فك قفل البرنامج والدخول إلى لوحة التحكم..." FontSize="12" Foreground="#A7F3D0" HorizontalAlignment="Center" Margin="0,6,0,10" />
                                <ProgressBar IsIndeterminate="True" Height="4" Background="#064E3B" Foreground="#34D399" BorderThickness="0" Width="220" />
                            </StackPanel>
                        </Border>

                        <!-- Normal Action Buttons (Collapsed when SuccessAnimation == True) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinkUnlock.IsSuccessAnimation}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Live Polling Progress Bar when verifying -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LinkUnlock.IsVerifying}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="⚡ بانتظار إكمال التحقق في المتصفح تلقائياً..." FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,6" HorizontalAlignment="Center" />
                                <ProgressBar IsIndeterminate="True" Height="4" Width="260" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button Style="{StaticResource PrimaryButtonStyle}" 
                                    Content="🌐 فتح صفحة التحقق في المتصفح" 
                                    Command="{Binding LinkUnlock.OpenBrowserCommand}" 
                                    Padding="20,12" 
                                    FontSize="14" 
                                    FontWeight="Bold"
                                    Margin="0,0,0,10" />

                            <Button Style="{StaticResource SecondaryButtonStyle}" 
                                    Content="🔄 فحص حالة التحقق الآن" 
                                    Command="{Binding LinkUnlock.CheckStatusNowCommand}" 
                                    Padding="16,9" />

                            <!-- Retry button when expired -->
                            <Button Content="🔁 بدء جلسة تحقق جديدة" 
                                    Command="{Binding LinkUnlock.RestartVerificationCommand}" 
                                    Margin="0,10,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LinkUnlock.HasError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- VIP / Lifetime Bypass Section -->
                            <StackPanel Margin="0,14,0,0">
                                <Button Content="🔑 لدي كود VIP / ترخيص دائم" 
                                        Command="{Binding LinkUnlock.ToggleVipSectionCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#60A5FA"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        HorizontalAlignment="Center" />

                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LinkUnlock.IsVipSectionVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="أدخل كود الـ VIP للتخطي الفوري والدائم:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding LinkUnlock.VipKeyInput, UpdateSourceTrigger=PropertyChanged}" 
                                                     Background="#020617" 
                                                     Foreground="#38BDF8" 
                                                     BorderBrush="#334155" 
                                                     FontFamily="Consolas" 
                                                     FontSize="12" 
                                                     FontWeight="Bold" 
                                                     Padding="8,6" />
                                            <Button Grid.Column="1" 
                                                    Content="تفعيل" 
                                                    Command="{Binding LinkUnlock.SubmitVipKeyCommand}" 
                                                    Style="{StaticResource PrimaryButtonStyle}" 
                                                    Padding="14,6" 
                                                    FontSize="11" 
                                                    Margin="6,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding LinkUnlock.VipStatusMessage}" FontSize="11" Foreground="#38BDF8" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- MANDATORY FORCED UPDATE OVERLAY (Panel.ZIndex="1001")    -->
            <!-- ======================================================== -->
            <Grid Grid.Row="1" Background="#F2030712" Panel.ZIndex="1001">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsForceUpdateRequired}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="520" 
                        Background="#0F172A" 
                        BorderBrush="#0284C7" 
                        BorderThickness="1.5" 
                        CornerRadius="20" 
                        Padding="36" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#0284C7" BlurRadius="40" ShadowDepth="0" Opacity="0.4" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header Icon -->
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🚀" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="تحديث إجباري مطلوب" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,14">
                            <TextBlock Text="يتوفر إصدار جديد من SideLink برقم: " FontSize="13" Foreground="#94A3B8" />
                            <Border Background="#0369A1" CornerRadius="6" Padding="6,2" Margin="6,0,0,0">
                                <TextBlock Text="{Binding ForceUpdateVersion, StringFormat='v{0}'}" FontSize="12" FontWeight="Bold" Foreground="White" FontFamily="Consolas" />
                            </Border>
                        </StackPanel>

                        <!-- Release Notes Box -->
                        <Border Background="#020617" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ملاحظات وتفاصيل التحديث:" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding ForceUpdateNotes}" 
                                           FontSize="12" 
                                           Foreground="#CBD5E1" 
                                           TextWrapping="Wrap" 
                                           LineHeight="20" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="لضمان استمرار عمل التوقيع الرقمي والاتصال بأجهزتك بشكل سليم، يلزم ترقية البرنامج للمتابعة." 
                                   FontSize="11.5" 
                                   Foreground="#64748B" 
                                   TextAlignment="Center" 
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,20" />

                        <!-- Action Buttons -->
                        <Button Content="تحميل وتثبيت التحديث الآن (Download Update)" 
                                Command="{Binding OpenForceUpdateUrlCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Height="44" 
                                FontSize="13" 
                                FontWeight="Bold" 
                                Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" 
                                    Content="إعادة الفحص" 
                                    Command="{Binding RetryGovernanceCheckCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="36" 
                                    FontSize="11" />
                            <Button Grid.Column="2" 
                                    Content="إغلاق البرنامج" 
                                    Command="{Binding ExitApplicationCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="36" 
                                    FontSize="11" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- REMOTE EMERGENCY KILL SWITCH OVERLAY (Panel.ZIndex="1002")-->
            <!-- ======================================================== -->
            <Grid Grid.Row="1" Background="#F8030712" Panel.ZIndex="1002">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmergencyLocked}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="520" 
                        Background="#0F172A" 
                        BorderBrush="#EF4444" 
                        BorderThickness="1.5" 
                        CornerRadius="20" 
                        Padding="36" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#EF4444" BlurRadius="40" ShadowDepth="0" Opacity="0.4" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header Icon -->
                        <Border Width="64" Height="64" CornerRadius="32" Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🛑" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="تم إيقاف تشغيل الأداة مؤقتاً" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="تنبيه إداري طارئ (System Suspended)" 
                                   FontSize="12" 
                                   Foreground="#F87171" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,4,0,18" />

                        <!-- Admin Message Box -->
                        <Border Background="#1C0B0E" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="رسالة الإدارة:" FontSize="12" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding EmergencyLockMessage}" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="#FEE2E2" 
                                           TextWrapping="Wrap" 
                                           LineHeight="22" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="تم تعليق عمليات التوقيع والتثبيت لحماية النظام مؤقتاً. سيتم استئناف الخدمة قريباً." 
                                   FontSize="11.5" 
                                   Foreground="#64748B" 
                                   TextAlignment="Center" 
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,20" />

                        <!-- Action Buttons -->
                        <Button Content="إعادة المحاولة والتحقق الآن" 
                                Command="{Binding RetryGovernanceCheckCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Height="42" 
                                FontSize="12" 
                                FontWeight="Bold" 
                                Margin="0,0,0,10" />

                        <Button Content="إغلاق التطبيق" 
                                Command="{Binding ExitApplicationCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Height="36" 
                                FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
