    <ProjectReference Include="..\BitLoader.IPA\BitLoader.IPA.csproj" />
    <ProjectReference Include="..\BitLoader.Signing\BitLoader.Signing.csproj" />
    <ProjectReference Include="..\BitLoader.Installation\BitLoader.Installation.csproj" />
    <ProjectReference Include="..\BitLoader.Refresh\BitLoader.Refresh.csproj" />
    <ProjectReference Include="..\BitLoader.Verification\BitLoader.Verification.csproj" />
    <ProjectReference Include="..\BitLoader.Infrastructure\BitLoader.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

</Project>
